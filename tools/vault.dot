digraph vault {
  graph [
    size="10,8",
    ratio=fill,
    bgcolor="#111111",
    overlap=false,
    splines=true,
    pad=0.4
  ]
  node [
    fontname="Segoe UI",
    fontsize=11,
    fontcolor="#e2e8f0",
    style="filled,bold",
    color="#334155"
  ]
  edge [
    color="#64748b",
    arrowsize=0.7
  ]

  node [shape=doublecircle, fillcolor="#0ea5e9", fontcolor="#0b1220"]
  HOME

  node [shape=box, fillcolor="#1d4ed8"]
  "10-Projects/Niyah.Engine"

  node [shape=hexagon, fillcolor="#7c3aed"]
  "30-Experiments"

  node [shape=box, fillcolor="#b45309"]
  "40-Evidence"

  node [shape=diamond, fillcolor="#15803d"]
  "60-Decisions"

  node [shape=note, fillcolor="#334155"]
  "50-Writing"
  "00-Inbox"

  node [shape=folder, fillcolor="#3f3f46"]
  "_Templates/Experiment"
  "_Templates/Decision"

  HOME -> "10-Projects/Niyah.Engine"
  HOME -> "30-Experiments"
  HOME -> "40-Evidence"
  HOME -> "60-Decisions"
  HOME -> "50-Writing"
  HOME -> "00-Inbox"
  "10-Projects/Niyah.Engine" -> "40-Evidence"
  "10-Projects/Niyah.Engine" -> "60-Decisions"
  "10-Projects/Niyah.Engine" -> "30-Experiments"
  "40-Evidence" -> "60-Decisions"
  "30-Experiments" -> "40-Evidence"
  "50-Writing" -> "10-Projects/Niyah.Engine"
  "_Templates/Experiment" -> "30-Experiments"
  "_Templates/Decision" -> "60-Decisions"
}